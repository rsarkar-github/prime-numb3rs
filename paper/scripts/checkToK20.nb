Cell[CellGroupData[{
Cell[TextData[StyleBox["Verifying the \[Omega]-inequality for \[Omega] \
\[LessEqual] 20",
 FontSize->24]], "Title",
 CellChangeTimes->{{3.6321168551173573`*^9, 3.632116869370555*^9}, {
  3.731594664035233*^9, 3.731594665014387*^9}, {3.73170441113909*^9, 
  3.731704412269177*^9}, {3.732446122761959*^9, 3.732446149588941*^9}, {
  3.906594771935112*^9, 3.906594772474153*^9}, {3.9989880704322*^9, 
  3.998988109950404*^9}, {3.998989285528634*^9, 3.998989291167132*^9}},
 FontFamily->"Chalkduster",
 FontSize->13,
 FontWeight->"Regular",ExpressionUUID->"76c6dd88-f1d5-4dcf-af7e-5f7cc9f4f641"],

Cell["\<\
To check the \[Omega] - inequality has no minimal counterexamples for a given \
value of \[Omega], simply run CHECK\[Omega][\[Omega], {}] . The results of \
the execution would give you a tally of how many cases pass the test . There \
may be memory issues for \[Omega] \[GreaterEqual] 19 (for instance with Apple \
M1 Pro, 16 GB) for which you may adapt the code as below to iterate over \
possible multiplicities of 2 allowed for a minimal counterexample .\
\>", "Subtitle",
 CellChangeTimes->{{3.99898811202712*^9, 3.998988149444029*^9}, 
   3.99898905311675*^9, {3.998989085757162*^9, 
   3.9989891175401506`*^9}},ExpressionUUID->"59d494ea-fbd6-45a4-8003-\
68ad295057bd"],

